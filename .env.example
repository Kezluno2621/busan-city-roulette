# 참고용 목록입니다. Spring Boot는 이 파일이나 .env를 자동으로 읽지 않습니다.
# STS Run Configurations > Environment에서 설정하세요.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cityroulette
# 본인의 MySQL 계정과 비밀번호를 로컬 실행 환경에만 입력하세요.
DB_USERNAME=
DB_PASSWORD=
# 한국관광공사 공공데이터포털에서 발급받은 키를 로컬 실행 환경에만 입력하세요.
TOUR_API_KEY=your_api_key
# ODsay Server API 키를 로컬 실행 환경에만 입력하세요.
ODSAY_API_KEY=your_api_key
# Kakao Developers 애플리케이션의 REST API 키를 입력하세요.
KAKAO_REST_API_KEY=your_rest_api_key
